{
  "name": "lockit_server",
  "version": "1.0.0",
  "description": "Server for the LockIt project",
  "type": "module",
  "main": "",
  "scripts": {
    "dev": "pnpm tsx watch src/bin/server.ts",
    "clean": "pnpm rimraf dist",
    "build": "pnpm clean && pnpm tsc && pnpm tsc-alias",
    "start": "node dist/bin/server.js",
    "typecheck": "pnpm tsc --noEmit",
    "format": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "lint": "pnpm eslint .",
    "lint:fix": "pnpm eslint . --fix"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakshayManglani/lockit_server.git"
  },
  "author": "Lakshay Manglani",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "envalid": "^8.2.0",
    "express": "^5.2.1"
  }
}
