NODE_ENV=production

# Runtime environment: development | production
# Controls verbose errors, e.g. stack traces on failed requests.
# Defaults to production when unset, so stacks are never leaked by accident.
APP_ENV=development

# HTTP server
PORT=8000

# CORS allowed origins (comma separated)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/lockit?schema=public

# JWT settings, generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=<generate with: openssl rand -hex 32>
ACCESS_TOKEN_EXPIRES=86400
REFRESH_TOKEN_SECRET=<generate with: openssl rand -hex 32>
REFRESH_TOKEN_EXPIRES=2592000

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
